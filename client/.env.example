# Use the same reachable backend URL on every computer.
VITE_API_URL=http://localhost:5000/api

# Optional when Socket.IO is hosted at a different origin than the API.
# VITE_SOCKET_URL=https://your-api.example.com

# Optional production ICE configuration. TURN credentials must be short-lived.
# VITE_STUN_URL=stun:your-stun-host:3478
# VITE_TURN_SERVER_URL=turn:your-turn-host:3478
# VITE_TURN_USERNAME=short-lived-username
# VITE_TURN_CREDENTIAL=short-lived-credential
